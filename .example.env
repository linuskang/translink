# Optional MapTiler API key for vector dark map tiles.
# Leave blank to automatically use keyless CARTO Dark Matter @2x tiles.
NEXT_PUBLIC_MAPTILER_KEY=

# Upstream SEQ Transit API base URL (server-side only, not exposed to browser)
TRANSIT_API_URL=http://localhost:8000
VEHICLE_API_URL=http://localhost:8000/v1/seq/vehicle_positions
